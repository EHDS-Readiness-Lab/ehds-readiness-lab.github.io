# Agile Health Informatics Ltd. Unofficial prototype vocabulary. Version 0.2.
# NOT an EHDS Data Quality and Utility Label ontology or an adopted standard.
# This URI is deployment-relative: keep the deployed file URL stable.
@prefix lr: <#> .
@prefix dqv: <http://www.w3.org/ns/dqv#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

lr:ReadinessRecord a rdfs:Class ; rdfs:subClassOf prov:Entity ; rdfs:label "Unofficial, draft dataset-release evidence assessment"@en .
lr:CriterionAssessment a rdfs:Class .
lr:UpstreamDependency a rdfs:Class .
lr:assesses a rdf:Property .
lr:criteriaSet a rdf:Property .
lr:datasetIdentifier a rdf:Property .
lr:hasAssessment a rdf:Property .
lr:criterion a rdf:Property .
lr:readinessState a rdf:Property .
lr:assessmentStatus a rdf:Property .
lr:validationIssueCount a rdf:Property .
lr:notApplicableReason a rdf:Property .
lr:applicabilityReviewer a rdf:Property .
lr:applicabilityReviewDate a rdf:Property .
lr:processMeasurement a rdf:Property .
lr:evidenceMeasurement a rdf:Property .
lr:procedure a rdf:Property .
lr:evidenceItem a rdf:Property .
lr:evidenceMethodLocation a rdf:Property .
lr:evidenceInputsLocation a rdf:Property .
lr:scope a rdf:Property .
lr:interpretationNote a rdf:Property .
lr:upstreamDependency a rdf:Property .
lr:upstreamParty a rdf:Property .
lr:prefilledFrom a rdf:Property .
lr:replaces a rdf:Property .
lr:EvidenceAvailable a skos:Concept ; skos:prefLabel "Evidence available"@en .
lr:EvidenceGap a skos:Concept ; skos:prefLabel "Evidence gap"@en .
lr:NotReady a skos:Concept ; skos:prefLabel "Not ready"@en .
lr:NotApplicable a skos:Concept ; skos:prefLabel "Not applicable"@en .
lr:Incomplete a skos:Concept ; skos:prefLabel "Incomplete"@en .
lr:EG-A a dqv:Category ; skos:prefLabel "Data documentation"@en .
lr:LR-01 a dqv:Dimension ; dqv:inCategory lr:EG-A ; skos:prefLabel "Metadata scope"@en .
lr:LR-01-process a dqv:Metric ; dqv:inDimension lr:LR-01 ; dqv:expectedDataType xsd:integer .
lr:LR-01-evidence a dqv:Metric ; dqv:inDimension lr:LR-01 ; dqv:expectedDataType xsd:integer .
lr:LR-02 a dqv:Dimension ; dqv:inCategory lr:EG-A ; skos:prefLabel "Data provenance"@en .
